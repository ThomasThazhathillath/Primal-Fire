<!--
  The satchel: tap an item with a fingertip to take it in hand. Item buttons item-0..item-17
  are filled in by SatchelSystem (name, then what it is for); craft buttons appear at a workbench.
  Every row leaves room on its left for a small picture of the item (SatchelSystem draws it).
-->
<style>
  .theme-begin { display: flex; }
  .t-root { background-color: rgba(238, 222, 184, 0.98); border-radius: 18px; border-width: 4px; border-color: #6e4a28; }
  .t-head { background-color: #4f5f33; border-radius: 12px; padding: 8px; }
  .t-headtext { color: #f6ecd2; font-size: 23px; font-weight: 700; }
  .t-title { color: #2d1f12; font-size: 27px; font-weight: 700; }
  .t-name { color: #2d1f12; font-size: 23px; font-weight: 700; }
  .t-lead { color: #2d1f12; font-size: 22px; line-height: 1.25; }
  .t-body { color: #2d1f12; font-size: 21px; line-height: 1.3; }
  .t-muted { color: #6a5740; font-size: 18px; line-height: 1.3; }
  .t-small { color: #2d1f12; font-size: 16px; font-weight: 700; }
  .t-label { color: #b2511a; font-size: 14px; font-weight: 700; letter-spacing: 1.5px; }
  .t-accent { color: #b2511a; font-size: 22px; font-weight: 700; }
  .t-note { color: #8a4a1c; font-size: 17px; line-height: 1.25; }
  .t-ok { color: #2c7a3e; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-bad { color: #a8301c; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-row { background-color: rgba(110, 72, 36, 0.14); border-radius: 12px; }
  .t-btn { background-color: #4f5f33; border-radius: 12px; }
  .t-go { background-color: #b2511a; border-radius: 12px; }
  .t-track { background-color: rgba(90, 60, 28, 0.22); border-radius: 4px; }
  .t-fill { background-color: #b2511a; border-radius: 4px; }
.theme-end { display: flex; }
  .root { flex-direction: column; width: 480px; padding-top: 22px; padding-bottom: 22px; padding-left: 26px; padding-right: 26px; gap: 12px; }
  .grid { flex-direction: row; flex-wrap: wrap; gap: 10px; }
  .item { width: 134px; }
  .irow { flex-direction: row; gap: 6px; width: 430px; }
  .bagrow { width: 338px; height: 56px; padding-left: 66px; }
  .delbtn { width: 86px; height: 56px; background-color: #8a4a1c; border-radius: 12px; }
  .deltext { font-size: 14px; color: #f6ecd2; font-weight: 700; }
  .bagtext { font-size: 16px; }
  .row { flex-direction: row; gap: 12px; }
  .back { width: 190px; height: 60px; }
</style>
<div class="root t-root">
  <div class="t-title">Bag</div>
  <div id="satchel-sub" class="t-muted">Tap an item to take it in hand. Tap Back to return to the icons.</div>
  <div class="grid">
    <div id="irow-0" class="irow"><Button id="item-0" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-0-label" class="bagtext">-</ButtonLabel></Button><Button id="del-0" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-0-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-1" class="irow"><Button id="item-1" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-1-label" class="bagtext">-</ButtonLabel></Button><Button id="del-1" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-1-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-2" class="irow"><Button id="item-2" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-2-label" class="bagtext">-</ButtonLabel></Button><Button id="del-2" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-2-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-3" class="irow"><Button id="item-3" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-3-label" class="bagtext">-</ButtonLabel></Button><Button id="del-3" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-3-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-4" class="irow"><Button id="item-4" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-4-label" class="bagtext">-</ButtonLabel></Button><Button id="del-4" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-4-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-5" class="irow"><Button id="item-5" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-5-label" class="bagtext">-</ButtonLabel></Button><Button id="del-5" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-5-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-6" class="irow"><Button id="item-6" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-6-label" class="bagtext">-</ButtonLabel></Button><Button id="del-6" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-6-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-7" class="irow"><Button id="item-7" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-7-label" class="bagtext">-</ButtonLabel></Button><Button id="del-7" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-7-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-8" class="irow"><Button id="item-8" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-8-label" class="bagtext">-</ButtonLabel></Button><Button id="del-8" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-8-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-9" class="irow"><Button id="item-9" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-9-label" class="bagtext">-</ButtonLabel></Button><Button id="del-9" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-9-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-10" class="irow"><Button id="item-10" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-10-label" class="bagtext">-</ButtonLabel></Button><Button id="del-10" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-10-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-11" class="irow"><Button id="item-11" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-11-label" class="bagtext">-</ButtonLabel></Button><Button id="del-11" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-11-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-12" class="irow"><Button id="item-12" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-12-label" class="bagtext">-</ButtonLabel></Button><Button id="del-12" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-12-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-13" class="irow"><Button id="item-13" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-13-label" class="bagtext">-</ButtonLabel></Button><Button id="del-13" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-13-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-14" class="irow"><Button id="item-14" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-14-label" class="bagtext">-</ButtonLabel></Button><Button id="del-14" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-14-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-15" class="irow"><Button id="item-15" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-15-label" class="bagtext">-</ButtonLabel></Button><Button id="del-15" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-15-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-16" class="irow"><Button id="item-16" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-16-label" class="bagtext">-</ButtonLabel></Button><Button id="del-16" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-16-label" class="deltext">Discard</ButtonLabel></Button></div>
    <div id="irow-17" class="irow"><Button id="item-17" class="bagrow t-btn" variant="secondary" size="sm"><ButtonLabel id="item-17-label" class="bagtext">-</ButtonLabel></Button><Button id="del-17" class="delbtn" variant="secondary" size="sm"><ButtonLabel id="del-17-label" class="deltext">Discard</ButtonLabel></Button></div>
  </div>
  <div id="make-title" class="t-muted">Make by hand (you have the parts):</div>
  <div class="grid">
    <Button id="make-0" class="item t-btn" size="sm"><ButtonLabel id="make-0-label">-</ButtonLabel></Button>
    <Button id="make-1" class="item t-btn" size="sm"><ButtonLabel id="make-1-label">-</ButtonLabel></Button>
    <Button id="make-2" class="item t-btn" size="sm"><ButtonLabel id="make-2-label">-</ButtonLabel></Button>
    <Button id="make-3" class="item t-btn" size="sm"><ButtonLabel id="make-3-label">-</ButtonLabel></Button>
    <Button id="make-4" class="item t-btn" size="sm"><ButtonLabel id="make-4-label">-</ButtonLabel></Button>
    <Button id="make-5" class="item t-btn" size="sm"><ButtonLabel id="make-5-label">-</ButtonLabel></Button>
    <Button id="make-6" class="item t-btn" size="sm"><ButtonLabel id="make-6-label">-</ButtonLabel></Button>
    <Button id="make-7" class="item t-btn" size="sm"><ButtonLabel id="make-7-label">-</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="stow-button" class="t-btn" variant="secondary" size="sm"><ButtonIcon><Undo2></Undo2></ButtonIcon><ButtonLabel id="stow-label">Put back</ButtonLabel></Button>
    <Button id="bag-more" class="t-btn" variant="secondary" size="sm"><ButtonIcon><ChevronDown></ChevronDown></ButtonIcon><ButtonLabel id="bag-more-label">More</ButtonLabel></Button>
    <Button id="satchel-close" class="back t-btn" variant="secondary" size="lg"><ButtonIcon><ArrowLeft></ArrowLeft></ButtonIcon><ButtonLabel>Back</ButtonLabel></Button>
  </div>
</div>

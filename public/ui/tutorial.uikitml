<!--
  The story card of "THE FIRST STEPS" (TutorialSystem). Compact: time of
  day, the step title and the next thing to do. Opened from the Story icon it
  also shows every task, a tip, Do again / Skip this / Skip to survival and a
  row of step numbers to replay any step. The choice row (Tutorial or Skip to survival) and the finish row
  replace the lesson body when shown. Same field-journal theme as the cards.
-->
<style>
  .theme-begin { display: flex; }
  .t-root { background-color: rgba(24, 16, 10, 0.98); border-radius: 18px; border-width: 8px; border-color: #6b4524; }
  .t-banner { flex-direction: row; align-items: center; justify-content: space-between; background-color: #5a2f16; border-radius: 12px; border-bottom-width: 4px; border-color: #c4893f; padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 10px; flex-shrink: 0; }
  .t-bannertext { color: #fbf0d6; font-size: 24px; font-weight: 700; letter-spacing: 1px; }
  .t-head { background-color: #5e6e34; border-radius: 12px; padding: 8px; }
  .t-headtext { color: #fbf0d6; font-size: 20px; font-weight: 700; }
  .t-title { color: #f3e6cc; font-size: 24px; font-weight: 700; line-height: 1.15; }
  .t-name { color: #f3e6cc; font-size: 20px; font-weight: 700; }
  .t-lead { color: #f3e6cc; font-size: 20px; line-height: 1.25; }
  .t-body { color: #f3e6cc; font-size: 19px; line-height: 1.3; }
  .t-muted { color: #cdb894; font-size: 18px; line-height: 1.3; }
  .t-small { color: #f3e6cc; font-size: 15px; font-weight: 700; }
  .t-label { color: #f0a54e; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
  .t-accent { color: #f0a54e; font-size: 20px; font-weight: 700; }
  .t-note { color: #e2b77a; font-size: 17px; line-height: 1.25; }
  .t-ok { color: #8fd49b; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-bad { color: #ff8f73; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-row { background-color: #3a2716; border-radius: 12px; border-width: 2px; border-color: #86643c; }
  .t-slot { background-color: #3a2716; border-radius: 12px; border-width: 2px; border-color: #86643c; }
  .t-slottext { color: #f3e6cc; font-weight: 600; }
  .t-tile { flex-direction: column; align-items: center; justify-content: flex-end; background-color: #3a2716; border-radius: 12px; padding-bottom: 8px; padding-left: 6px; padding-right: 6px; }
  .t-tiletext { color: #f3e6cc; font-size: 15px; font-weight: 700; line-height: 1.2; text-align: center; }
  .t-detail { background-color: rgba(255, 220, 170, 0.08); border-radius: 12px; padding: 10px; color: #f3e6cc; font-size: 18px; line-height: 1.3; flex-shrink: 0; }
  .t-rule { height: 2px; background-color: rgba(196, 137, 63, 0.55); flex-shrink: 0; }
  .t-btn { background-color: #5e6e34; border-radius: 12px; }
  .t-go { background-color: #f0a54e; border-radius: 12px; }
  .t-track { background-color: rgba(255, 225, 180, 0.16); border-radius: 4px; }
  .t-fill { background-color: #f0a54e; border-radius: 4px; }
.theme-end { display: flex; }
  .root { flex-direction: column; width: 520px; padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px; gap: 8px; }
  .row { flex-direction: row; gap: 8px; align-items: center; flex-wrap: wrap; }
  .tasks { flex-direction: column; gap: 6px; }
  .task { width: 480px; color: #f3e6cc; font-size: 30px; font-weight: 700; line-height: 1.2; }
  .btntext { color: #f6ecd2; font-weight: 700; }
  .wide { width: 480px; }
  .tbox { flex-direction: column; }
  .num { width: 38px; height: 38px; }
  .cele { flex-direction: column; gap: 10px; background-color: #2c6a3d; border-radius: 12px; padding: 14px; display: none; }
  .celetext { color: #ffffff; font-size: 22px; font-weight: 700; line-height: 1.25; width: 440px; }
</style>
<div id="tut-root" class="root t-root">
  <div class="t-banner"><div class="tbox"><div id="tut-label" class="t-label">DAY 1 - AFTERNOON</div><div id="tut-title" class="t-bannertext">Waking</div></div></div>
  <div id="tut-body" class="tasks">
    <div id="tut-say" class="wide t-lead">-</div>
    <div id="tut-body-0" class="task">-</div>
    <div id="tut-body-1" class="task">-</div>
    <div id="tut-body-2" class="task">-</div>
    <div id="tut-body-3" class="task">-</div>
    <div id="tut-tip" class="wide t-muted">-</div>
    <div id="tut-ctrl" class="row">
      <Button id="tut-why" class="t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-why-t" class="btntext">Why?</ButtonLabel></Button>
      <Button id="tut-repeat" class="t-btn" size="sm" variant="secondary"><ButtonLabel class="btntext">Again</ButtonLabel></Button>
      <Button id="tut-skip" class="t-btn" size="sm" variant="secondary"><ButtonLabel class="btntext">Skip</ButtonLabel></Button>
      <Button id="tut-leave" class="t-btn" size="sm" variant="secondary"><ButtonLabel class="btntext">Skip all</ButtonLabel></Button>
    </div>
    <div id="tut-nums" class="row">
      <Button id="tut-l0" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l0-t" class="btntext">1</ButtonLabel></Button>
      <Button id="tut-l1" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l1-t" class="btntext">2</ButtonLabel></Button>
      <Button id="tut-l2" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l2-t" class="btntext">3</ButtonLabel></Button>
      <Button id="tut-l3" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l3-t" class="btntext">4</ButtonLabel></Button>
      <Button id="tut-l4" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l4-t" class="btntext">5</ButtonLabel></Button>
      <Button id="tut-l5" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l5-t" class="btntext">6</ButtonLabel></Button>
      <Button id="tut-l6" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l6-t" class="btntext">7</ButtonLabel></Button>
      <Button id="tut-l7" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l7-t" class="btntext">8</ButtonLabel></Button>
      <Button id="tut-l8" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l8-t" class="btntext">9</ButtonLabel></Button>
      <Button id="tut-l9" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l9-t" class="btntext">10</ButtonLabel></Button>
      <Button id="tut-l10" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l10-t" class="btntext">11</ButtonLabel></Button>
      <Button id="tut-l11" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l11-t" class="btntext">12</ButtonLabel></Button>
    </div>
  </div>
  <div id="tut-cele" class="cele">
    <div id="tut-cele-text" class="celetext">You can survive out here.</div>
    <div class="row">
      <Button id="tut-start" class="t-go" size="sm"><ButtonLabel id="tut-start-t" class="btntext">Start survival</ButtonLabel></Button>
      <Button id="tut-again" class="t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-again-t" class="btntext">Stay and practise</ButtonLabel></Button>
    </div>
  </div>
</div>

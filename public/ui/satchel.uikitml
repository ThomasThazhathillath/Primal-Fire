<!--
  The satchel: tap an item with a fingertip to take it in hand. Item buttons item-0..item-17
  are filled in by SatchelSystem (name, then what it is for); craft buttons appear at a workbench.
  Every row leaves room on its left for a small picture of the item (SatchelSystem draws it).
-->
<style>
  .theme-begin { display: flex; }
  .t-root { background-color: rgba(24, 16, 10, 0.98); border-radius: 18px; border-width: 8px; border-color: #6b4524; }
  .t-banner { flex-direction: row; align-items: center; justify-content: space-between; background-color: #5a2f16; border-radius: 12px; border-bottom-width: 4px; border-color: #c4893f; padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 10px; flex-shrink: 0; }
  .t-bannertext { color: #fbf0d6; font-size: 24px; font-weight: 700; letter-spacing: 1px; }
  .t-head { background-color: #5e6e34; border-radius: 12px; padding: 8px; }
  .t-headtext { color: #fbf0d6; font-size: 20px; font-weight: 700; }
  .t-title { color: #f3e6cc; font-size: 24px; font-weight: 700; line-height: 1.15; }
  .t-name { color: #f3e6cc; font-size: 20px; font-weight: 700; }
  .t-lead { color: #f3e6cc; font-size: 20px; line-height: 1.25; }
  .t-body { color: #f3e6cc; font-size: 19px; line-height: 1.3; }
  .t-muted { color: #cdb894; font-size: 18px; line-height: 1.3; }
  .t-small { color: #f3e6cc; font-size: 15px; font-weight: 700; }
  .t-label { color: #f0a54e; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
  .t-accent { color: #f0a54e; font-size: 20px; font-weight: 700; }
  .t-note { color: #e2b77a; font-size: 17px; line-height: 1.25; }
  .t-ok { color: #8fd49b; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-bad { color: #ff8f73; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-row { background-color: #3a2716; border-radius: 12px; border-width: 2px; border-color: #86643c; }
  .t-slot { background-color: #3a2716; border-radius: 12px; border-width: 2px; border-color: #86643c; }
  .t-slottext { color: #f3e6cc; font-weight: 600; }
  .t-tile { flex-direction: column; align-items: center; justify-content: flex-end; background-color: #3a2716; border-radius: 12px; padding-bottom: 8px; padding-left: 6px; padding-right: 6px; }
  .t-tiletext { color: #f3e6cc; font-size: 15px; font-weight: 700; line-height: 1.2; text-align: center; }
  .t-detail { background-color: rgba(255, 220, 170, 0.08); border-radius: 12px; padding: 10px; color: #f3e6cc; font-size: 18px; line-height: 1.3; flex-shrink: 0; }
  .t-rule { height: 2px; background-color: rgba(196, 137, 63, 0.55); flex-shrink: 0; }
  .t-btn { background-color: #5e6e34; border-radius: 12px; }
  .t-go { background-color: #f0a54e; border-radius: 12px; }
  .t-track { background-color: rgba(255, 225, 180, 0.16); border-radius: 4px; }
  .t-fill { background-color: #f0a54e; border-radius: 4px; }
.theme-end { display: flex; }
  .root { flex-direction: column; width: 480px; padding-top: 16px; padding-bottom: 20px; padding-left: 18px; padding-right: 18px; gap: 10px; }
  .grid { flex-direction: row; flex-wrap: wrap; gap: 8px; width: 444px; }
  .item { width: 134px; }
  .irow { flex-direction: column; }
  .bagrow { width: 128px; height: 124px; }
  .bagtext { font-size: 16px; line-height: 1.2; }
  .row { flex-direction: row; gap: 12px; }
  .back { width: 190px; height: 60px; }
</style>
<div class="root t-root">
  <div class="t-banner"><div class="t-bannertext">Bag</div></div>
  <div id="satchel-sub" class="t-muted">Tap an item to take it in hand. Tap Back to return to the icons.</div>
  <div class="grid">
    <div id="irow-0" class="irow"><Button id="item-0" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-0-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-1" class="irow"><Button id="item-1" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-1-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-2" class="irow"><Button id="item-2" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-2-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-3" class="irow"><Button id="item-3" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-3-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-4" class="irow"><Button id="item-4" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-4-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-5" class="irow"><Button id="item-5" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-5-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-6" class="irow"><Button id="item-6" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-6-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-7" class="irow"><Button id="item-7" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-7-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-8" class="irow"><Button id="item-8" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-8-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-9" class="irow"><Button id="item-9" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-9-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-10" class="irow"><Button id="item-10" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-10-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-11" class="irow"><Button id="item-11" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-11-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-12" class="irow"><Button id="item-12" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-12-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-13" class="irow"><Button id="item-13" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-13-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-14" class="irow"><Button id="item-14" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-14-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-15" class="irow"><Button id="item-15" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-15-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-16" class="irow"><Button id="item-16" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-16-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
    <div id="irow-17" class="irow"><Button id="item-17" class="bagrow t-tile" variant="secondary" size="sm"><ButtonLabel id="item-17-label" class="bagtext t-tiletext">-</ButtonLabel></Button></div>
  </div>
  <div id="bag-detail" class="t-detail">Tap an item to take it in hand and read what it is for.</div>
  <div id="make-title" class="t-muted">Make by hand (you have the parts):</div>
  <div class="grid">
    <Button id="make-0" class="item t-btn" size="sm"><ButtonLabel id="make-0-label">-</ButtonLabel></Button>
    <Button id="make-1" class="item t-btn" size="sm"><ButtonLabel id="make-1-label">-</ButtonLabel></Button>
    <Button id="make-2" class="item t-btn" size="sm"><ButtonLabel id="make-2-label">-</ButtonLabel></Button>
    <Button id="make-3" class="item t-btn" size="sm"><ButtonLabel id="make-3-label">-</ButtonLabel></Button>
    <Button id="make-4" class="item t-btn" size="sm"><ButtonLabel id="make-4-label">-</ButtonLabel></Button>
    <Button id="make-5" class="item t-btn" size="sm"><ButtonLabel id="make-5-label">-</ButtonLabel></Button>
    <Button id="make-6" class="item t-btn" size="sm"><ButtonLabel id="make-6-label">-</ButtonLabel></Button>
    <Button id="make-7" class="item t-btn" size="sm"><ButtonLabel id="make-7-label">-</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="stow-button" class="t-btn" variant="secondary" size="sm"><ButtonIcon><Undo2></Undo2></ButtonIcon><ButtonLabel id="stow-label">Put back</ButtonLabel></Button>
    <Button id="bag-more" class="t-btn" variant="secondary" size="sm"><ButtonIcon><ChevronDown></ChevronDown></ButtonIcon><ButtonLabel id="bag-more-label">More</ButtonLabel></Button>
    <Button id="satchel-close" class="back t-btn" variant="secondary" size="lg"><ButtonIcon><ArrowLeft></ArrowLeft></ButtonIcon><ButtonLabel>Back</ButtonLabel></Button>
  </div>
</div>

<!-- Floating label over whatever you are pointing at. -->
<style>
  .root { flex-direction: column; padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 14px; }
  .text { color: #1c1d20; font-size: 18px; font-weight: 700; }
  .text:dark { color: #fff7e6; }
  .sub { color: #55504a; font-size: 13px; }
  .sub:dark { color: #ffd27a; }
</style>
<Panel class="root">
  <div id="tip-text" class="text">-</div>
  <div id="tip-sub" class="sub">-</div>
</Panel>

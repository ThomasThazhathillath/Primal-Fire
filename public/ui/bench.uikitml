<!--
  Workbench recipes. List view: every bench recipe with have/need parts (dim
  when something is missing). Craft view: the current step, a hand cue and a
  progress bar. Filled in by BenchSystem.
-->
<style>
  .theme-begin { display: flex; }
  .t-root { background-color: rgba(24, 16, 10, 0.98); border-radius: 18px; border-width: 8px; border-color: #6b4524; }
  .t-banner { flex-direction: row; align-items: center; justify-content: space-between; background-color: #5a2f16; border-radius: 12px; border-bottom-width: 4px; border-color: #c4893f; padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 10px; flex-shrink: 0; }
  .t-bannertext { color: #fbf0d6; font-size: 24px; font-weight: 700; letter-spacing: 1px; }
  .t-head { background-color: #5e6e34; border-radius: 12px; padding: 8px; }
  .t-headtext { color: #fbf0d6; font-size: 20px; font-weight: 700; }
  .t-title { color: #f3e6cc; font-size: 24px; font-weight: 700; line-height: 1.15; }
  .t-name { color: #f3e6cc; font-size: 20px; font-weight: 700; }
  .t-lead { color: #f3e6cc; font-size: 20px; line-height: 1.25; }
  .t-body { color: #f3e6cc; font-size: 19px; line-height: 1.3; }
  .t-muted { color: #cdb894; font-size: 18px; line-height: 1.3; }
  .t-small { color: #f3e6cc; font-size: 15px; font-weight: 700; }
  .t-label { color: #f0a54e; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
  .t-accent { color: #f0a54e; font-size: 20px; font-weight: 700; }
  .t-note { color: #e2b77a; font-size: 17px; line-height: 1.25; }
  .t-ok { color: #8fd49b; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-bad { color: #ff8f73; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-row { background-color: #3a2716; border-radius: 12px; border-width: 2px; border-color: #86643c; }
  .t-slot { background-color: #3a2716; border-radius: 12px; border-width: 2px; border-color: #86643c; }
  .t-slottext { color: #f3e6cc; font-weight: 600; }
  .t-tile { flex-direction: column; align-items: center; justify-content: flex-end; background-color: #3a2716; border-radius: 12px; padding-bottom: 8px; padding-left: 6px; padding-right: 6px; }
  .t-tiletext { color: #f3e6cc; font-size: 15px; font-weight: 700; line-height: 1.2; text-align: center; }
  .t-detail { background-color: rgba(255, 220, 170, 0.08); border-radius: 12px; padding: 10px; color: #f3e6cc; font-size: 18px; line-height: 1.3; flex-shrink: 0; }
  .t-rule { height: 2px; background-color: rgba(196, 137, 63, 0.55); flex-shrink: 0; }
  .t-btn { background-color: #5e6e34; border-radius: 12px; }
  .t-go { background-color: #f0a54e; border-radius: 12px; }
  .t-track { background-color: rgba(255, 225, 180, 0.16); border-radius: 4px; }
  .t-fill { background-color: #f0a54e; border-radius: 4px; }
.theme-end { display: flex; }
  .root { flex-direction: column; width: 560px; padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px; gap: 8px; }
  .head { flex-direction: row; justify-content: space-between; align-items: center; }
  .headright { flex-direction: row; gap: 8px; }
  .title { line-height: 1.15; }
  .list { flex-direction: column; gap: 5px; }
  .row { width: 520px; flex-direction: column; gap: 2px; padding-top: 8px; padding-bottom: 8px; padding-left: 76px; padding-right: 12px; min-height: 56px; border-radius: 12px; }
  .step { line-height: 1.2; }
  .hint { line-height: 1.3; }
  .track { width: 260px; height: 6px; border-radius: 3px; }
  .fill { width: 0px; height: 6px; border-radius: 3px; }
  .buttons { flex-direction: row; gap: 10px; }
  .back { width: 190px; height: 60px; }
</style>
<div class="root t-root">
  <div class="head t-banner">
    <div id="bench-eyebrow" class="eyebrow t-bannertext">WORKBENCH</div>
    <div class="headright">
      <Button id="bench-lift" class="t-btn" variant="secondary" size="sm"><ButtonLabel>Lift slab off</ButtonLabel></Button>
      <Button id="bench-close" class="back t-btn" variant="secondary" size="lg"><ButtonIcon><ArrowLeft></ArrowLeft></ButtonIcon><ButtonLabel>Back</ButtonLabel></Button>
    </div>
  </div>
  <div id="bench-list" class="list">
    <div class="title t-title">What will you make?</div>
    <div id="rec-0" class="row t-row">
      <div id="rec-0-name" class="name t-name">-</div>
      <div id="rec-0-parts" class="parts t-muted">-</div>
    </div>
    <div id="rec-1" class="row t-row">
      <div id="rec-1-name" class="name t-name">-</div>
      <div id="rec-1-parts" class="parts t-muted">-</div>
    </div>
    <div id="rec-2" class="row t-row">
      <div id="rec-2-name" class="name t-name">-</div>
      <div id="rec-2-parts" class="parts t-muted">-</div>
    </div>
    <div id="rec-3" class="row t-row">
      <div id="rec-3-name" class="name t-name">-</div>
      <div id="rec-3-parts" class="parts t-muted">-</div>
    </div>
    <div id="rec-4" class="row t-row">
      <div id="rec-4-name" class="name t-name">-</div>
      <div id="rec-4-parts" class="parts t-muted">-</div>
    </div>
    <div id="rec-5" class="row t-row">
      <div id="rec-5-name" class="name t-name">-</div>
      <div id="rec-5-parts" class="parts t-muted">-</div>
    </div>
    <div id="rec-6" class="row t-row">
      <div id="rec-6-name" class="name t-name">-</div>
      <div id="rec-6-parts" class="parts t-muted">-</div>
    </div>
    <div id="rec-7" class="row t-row">
      <div id="rec-7-name" class="name t-name">-</div>
      <div id="rec-7-parts" class="parts t-muted">-</div>
    </div>
    <div id="rec-8" class="row t-row">
      <div id="rec-8-name" class="name t-name">-</div>
      <div id="rec-8-parts" class="parts t-muted">-</div>
    </div>
    <div id="rec-9" class="row t-row">
      <div id="rec-9-name" class="name t-name">-</div>
      <div id="rec-9-parts" class="parts t-muted">-</div>
    </div>
  </div>
  <div id="bench-craft" class="list">
    <div id="bench-recipe" class="title t-title">-</div>
    <div id="bench-steps" class="steps t-muted">-</div>
    <div id="bench-step" class="step t-lead">-</div>
    <div id="bench-cue" class="cue t-accent">-</div>
    <div class="track t-track"><div id="bench-fill" class="fill t-fill"></div></div>
    <div id="bench-hint" class="hint t-body">-</div>
    <div class="buttons">
      <Button id="bench-cancel" class="t-btn" variant="secondary" size="sm"><ButtonIcon><Undo2></Undo2></ButtonIcon><ButtonLabel>Stop and take the parts back</ButtonLabel></Button>
    </div>
  </div>
</div>

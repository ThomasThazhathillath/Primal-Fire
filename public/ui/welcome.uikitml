<!-- Title and onboarding: shown when you wake up. -->
<style>
  .theme-begin { display: flex; }
  .t-root { background-color: rgba(238, 222, 184, 0.98); border-radius: 18px; border-width: 4px; border-color: #6e4a28; }
  .t-head { background-color: #4f5f33; border-radius: 12px; padding: 8px; }
  .t-headtext { color: #f6ecd2; font-size: 23px; font-weight: 700; }
  .t-title { color: #2d1f12; font-size: 27px; font-weight: 700; }
  .t-name { color: #2d1f12; font-size: 23px; font-weight: 700; }
  .t-lead { color: #2d1f12; font-size: 22px; line-height: 1.25; }
  .t-body { color: #2d1f12; font-size: 21px; line-height: 1.3; }
  .t-muted { color: #6a5740; font-size: 18px; line-height: 1.3; }
  .t-small { color: #2d1f12; font-size: 16px; font-weight: 700; }
  .t-label { color: #b2511a; font-size: 14px; font-weight: 700; letter-spacing: 1.5px; }
  .t-accent { color: #b2511a; font-size: 22px; font-weight: 700; }
  .t-note { color: #8a4a1c; font-size: 17px; line-height: 1.25; }
  .t-ok { color: #2c7a3e; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-bad { color: #a8301c; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-row { background-color: rgba(110, 72, 36, 0.14); border-radius: 12px; }
  .t-btn { background-color: #4f5f33; border-radius: 12px; }
  .t-go { background-color: #b2511a; border-radius: 12px; }
  .t-track { background-color: rgba(90, 60, 28, 0.22); border-radius: 4px; }
  .t-fill { background-color: #b2511a; border-radius: 4px; }
.theme-end { display: flex; }
  .panel-root { flex-direction: column; width: 520px; padding: 28px; gap: 12px; align-items: center; }
  .eyebrow { color: #b2511a; font-size: 18px; font-weight: 700; letter-spacing: 3px; }
  .heading { color: #2d1f12; font-size: 84px; font-weight: 700; letter-spacing: 10px; line-height: 1.1; }
  .sub { color: #6a5740; font-size: 22px; line-height: 1.3; text-align: center; width: 440px; }
  .menu { flex-direction: column; gap: 12px; width: 440px; margin-top: 10px; }
  .big { width: 440px; height: 68px; justify-content: center; }
  .btntext { color: #f6ecd2; font-size: 26px; font-weight: 700; }
</style>
<div class="panel-root t-root">
  <div class="eyebrow">A SURVIVAL STORY</div>
  <div class="heading">PRIMAL</div>
  <div class="sub">You wake on the forest floor with nothing. Every machine is gone. The science isn't.</div>
  <div class="menu">
    <Button class="t-go big" id="begin-button" size="lg"><ButtonIcon class="btntext"><Sunrise></Sunrise></ButtonIcon><ButtonLabel id="begin-label" class="btntext">Play</ButtonLabel></Button>
    <Button class="t-btn big" id="tutorial-button" size="lg"><ButtonIcon class="btntext"><GraduationCap></GraduationCap></ButtonIcon><ButtonLabel id="tutorial-label" class="btntext">Tutorial</ButtonLabel></Button>
    <Button class="t-btn big" id="new-button" size="lg"><ButtonIcon class="btntext"><ListRestart></ListRestart></ButtonIcon><ButtonLabel id="new-label" class="btntext">New Game</ButtonLabel></Button>
    <Button class="t-btn big" id="xr-button" size="lg"><ButtonIcon class="btntext"><RectangleGoggles></RectangleGoggles></ButtonIcon><ButtonLabel class="btntext">Enter VR</ButtonLabel></Button>
    <Button class="t-btn big" id="quit-button" size="lg"><ButtonIcon class="btntext"><LogOut></LogOut></ButtonIcon><ButtonLabel id="quit-label" class="btntext">Quit</ButtonLabel></Button>
  </div>
</div>

<!-- Title and onboarding: shown when you wake up. -->
<style>
  .theme-begin { display: flex; }
  .t-root { background-color: rgba(240, 226, 192, 0.98); border-radius: 18px; border-width: 6px; border-color: #5a3a1c; }
  .t-head { background-color: #4f5f33; border-radius: 12px; padding: 8px; }
  .t-headtext { color: #f6ecd2; font-size: 20px; font-weight: 700; }
  .t-title { color: #2d1f12; font-size: 24px; font-weight: 700; line-height: 1.15; }
  .t-name { color: #2d1f12; font-size: 20px; font-weight: 700; }
  .t-lead { color: #2d1f12; font-size: 20px; line-height: 1.25; }
  .t-body { color: #2d1f12; font-size: 19px; line-height: 1.3; }
  .t-muted { color: #5a4630; font-size: 18px; line-height: 1.3; }
  .t-small { color: #2d1f12; font-size: 15px; font-weight: 700; }
  .t-label { color: #9c4314; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
  .t-accent { color: #9c4314; font-size: 20px; font-weight: 700; }
  .t-note { color: #7a3e14; font-size: 17px; line-height: 1.25; }
  .t-ok { color: #2c7a3e; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-bad { color: #a8301c; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-row { background-color: rgba(255, 250, 236, 0.72); border-radius: 12px; border-width: 2px; border-color: rgba(90, 58, 28, 0.38); }
  .t-slot { background-color: rgba(255, 250, 236, 0.72); border-radius: 12px; border-width: 2px; border-color: rgba(90, 58, 28, 0.38); }
  .t-slottext { color: #2d1f12; font-weight: 600; }
  .t-rule { height: 2px; background-color: rgba(90, 58, 28, 0.35); flex-shrink: 0; }
  .t-btn { background-color: #4f5f33; border-radius: 12px; }
  .t-go { background-color: #9c4314; border-radius: 12px; }
  .t-track { background-color: rgba(90, 60, 28, 0.22); border-radius: 4px; }
  .t-fill { background-color: #9c4314; border-radius: 4px; }
.theme-end { display: flex; }
  .panel-root { flex-direction: column; width: 420px; }
  .panel-content { flex-direction: column; gap: 9px; padding: 24px; }
  .eyebrow { color: #b2511a; font-size: 14px; font-weight: 700; letter-spacing: 1.4px; }
  .heading { color: #2d1f12; font-size: 34px; font-weight: 700; line-height: 40px; }
  .body { color: #2d1f12; font-size: 18px; line-height: 25px; }
  .how { color: #2d1f12; font-size: 15px; line-height: 22px; }
  .btntext { color: #f6ecd2; font-size: 22px; font-weight: 700; }
  .button { justify-content: flex-start; margin-left: 24px; margin-right: 24px; margin-bottom: 14px; }
</style>
<div class="panel-root t-root">
  <div class="panel-content">
    <div class="eyebrow">CHAPTER 1</div>
    <div class="heading">PRIMAL: First Fire</div>
    <div class="body">You wake on the forest floor with nothing. Every machine is gone. The science isn't.</div>
    <div class="how">Point and pinch to gather: it goes into the pouch at your hip. To build, pinch an empty glowing mark - a stone from the pouch fills it, and the next one comes to your hand.</div>
    <div class="how">Stuck? Ask for a hint - ask again for a clearer one.</div>
  </div>
  <Button class="t-btn" id="xr-button" class="button">
    <ButtonIcon class="btntext"><RectangleGoggles></RectangleGoggles></ButtonIcon>
    <ButtonLabel class="btntext">Enter VR</ButtonLabel>
  </Button>
  <Button class="t-btn" id="tutorial-button" class="button">
    <ButtonIcon class="btntext"><GraduationCap></GraduationCap></ButtonIcon>
    <ButtonLabel id="tutorial-label" class="btntext">Learn the basics</ButtonLabel>
  </Button>
  <Button class="t-btn" id="begin-button" class="button">
    <ButtonIcon class="btntext"><Sunrise></Sunrise></ButtonIcon>
    <ButtonLabel id="begin-label" class="btntext">Wake up</ButtonLabel>
  </Button>
</div>

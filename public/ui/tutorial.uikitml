<!--
  The story card of "THE FIRST STEPS" (TutorialSystem). Compact: time of
  day, the step title and the next thing to do. Opened from the Story icon it
  also shows every task, a tip, Do again / Skip this / Skip to survival and a
  row of step numbers to replay any step. The choice row (Tutorial or Skip to survival) and the finish row
  replace the lesson body when shown. Same field-journal theme as the cards.
-->
<style>
  .theme-begin { display: flex; }
  .t-root { background-color: rgba(238, 222, 184, 0.98); border-radius: 18px; border-width: 4px; border-color: #6e4a28; }
  .t-head { background-color: #4f5f33; border-radius: 12px; padding: 8px; }
  .t-headtext { color: #f6ecd2; font-size: 23px; font-weight: 700; }
  .t-title { color: #2d1f12; font-size: 27px; font-weight: 700; }
  .t-name { color: #2d1f12; font-size: 23px; font-weight: 700; }
  .t-lead { color: #2d1f12; font-size: 22px; line-height: 1.25; }
  .t-body { color: #2d1f12; font-size: 21px; line-height: 1.3; }
  .t-muted { color: #6a5740; font-size: 18px; line-height: 1.3; }
  .t-small { color: #2d1f12; font-size: 16px; font-weight: 700; }
  .t-label { color: #b2511a; font-size: 14px; font-weight: 700; letter-spacing: 1.5px; }
  .t-accent { color: #b2511a; font-size: 22px; font-weight: 700; }
  .t-note { color: #8a4a1c; font-size: 17px; line-height: 1.25; }
  .t-ok { color: #2c7a3e; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-bad { color: #a8301c; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-row { background-color: rgba(110, 72, 36, 0.14); border-radius: 12px; }
  .t-btn { background-color: #4f5f33; border-radius: 12px; }
  .t-go { background-color: #b2511a; border-radius: 12px; }
  .t-track { background-color: rgba(90, 60, 28, 0.22); border-radius: 4px; }
  .t-fill { background-color: #b2511a; border-radius: 4px; }
.theme-end { display: flex; }
  .root { flex-direction: column; width: 520px; padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px; gap: 8px; }
  .row { flex-direction: row; gap: 8px; align-items: center; flex-wrap: wrap; }
  .tasks { flex-direction: column; gap: 6px; }
  .task { width: 480px; }
  .wide { width: 480px; }
  .num { width: 38px; height: 38px; }
  .cele { flex-direction: column; gap: 10px; background-color: #2c6a3d; border-radius: 12px; padding: 14px; display: none; }
  .celetext { color: #ffffff; font-size: 22px; font-weight: 700; line-height: 1.25; width: 440px; }
</style>
<div id="tut-root" class="root t-root">
  <div id="tut-label" class="t-label">DAY 1 - AFTERNOON</div>
  <div id="tut-title" class="t-title">Waking</div>
  <div id="tut-body" class="tasks">
    <div id="tut-say" class="wide t-lead">-</div>
    <div id="tut-body-0" class="task t-body">-</div>
    <div id="tut-body-1" class="task t-body">-</div>
    <div id="tut-body-2" class="task t-body">-</div>
    <div id="tut-body-3" class="task t-body">-</div>
    <div id="tut-tip" class="wide t-muted">-</div>
    <div id="tut-ctrl" class="row">
      <Button id="tut-repeat" class="t-btn" size="sm" variant="secondary"><ButtonLabel>Do again</ButtonLabel></Button>
      <Button id="tut-skip" class="t-btn" size="sm" variant="secondary"><ButtonLabel>Skip this</ButtonLabel></Button>
      <Button id="tut-leave" class="t-btn" size="sm" variant="secondary"><ButtonLabel>Skip to survival</ButtonLabel></Button>
    </div>
    <div id="tut-nums" class="row">
      <Button id="tut-l0" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l0-t">1</ButtonLabel></Button>
      <Button id="tut-l1" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l1-t">2</ButtonLabel></Button>
      <Button id="tut-l2" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l2-t">3</ButtonLabel></Button>
      <Button id="tut-l3" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l3-t">4</ButtonLabel></Button>
      <Button id="tut-l4" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l4-t">5</ButtonLabel></Button>
      <Button id="tut-l5" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l5-t">6</ButtonLabel></Button>
      <Button id="tut-l6" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l6-t">7</ButtonLabel></Button>
      <Button id="tut-l7" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l7-t">8</ButtonLabel></Button>
      <Button id="tut-l8" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l8-t">9</ButtonLabel></Button>
      <Button id="tut-l9" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l9-t">10</ButtonLabel></Button>
      <Button id="tut-l10" class="num t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-l10-t">11</ButtonLabel></Button>
    </div>
  </div>
  <div id="tut-cele" class="cele">
    <div id="tut-cele-text" class="celetext">You can survive out here.</div>
    <div class="row">
      <Button id="tut-start" class="t-go" size="sm"><ButtonLabel id="tut-start-t">Start survival</ButtonLabel></Button>
      <Button id="tut-again" class="t-btn" size="sm" variant="secondary"><ButtonLabel id="tut-again-t">Stay and practise</ButtonLabel></Button>
    </div>
  </div>
</div>

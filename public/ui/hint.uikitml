<!--
  Hint = Find (HintPanelSystem): every item you can gather, one button each (the current step's needs first, in
  orange). Choosing one puts a sky beacon on every spot of it on the map (BeaconSystem); Clear beacons turns them off.
  28 item buttons (find-0 .. find-27, game/find.ts FIND_SLOTS), 4 to a row.
-->
<style>
  .theme-begin { display: flex; }
  .t-root { background-color: rgba(24, 16, 10, 0.98); border-radius: 18px; border-width: 8px; border-color: #6b4524; }
  .t-banner { flex-direction: row; align-items: center; justify-content: space-between; background-color: #5a2f16; border-radius: 12px; border-bottom-width: 4px; border-color: #c4893f; padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 10px; flex-shrink: 0; }
  .t-bannertext { color: #fbf0d6; font-size: 24px; font-weight: 700; letter-spacing: 1px; }
  .t-head { background-color: #5e6e34; border-radius: 12px; padding: 8px; }
  .t-headtext { color: #fbf0d6; font-size: 20px; font-weight: 700; }
  .t-title { color: #f3e6cc; font-size: 24px; font-weight: 700; line-height: 1.15; }
  .t-name { color: #f3e6cc; font-size: 20px; font-weight: 700; }
  .t-lead { color: #f3e6cc; font-size: 20px; line-height: 1.25; }
  .t-body { color: #f3e6cc; font-size: 19px; line-height: 1.3; }
  .t-muted { color: #cdb894; font-size: 18px; line-height: 1.3; }
  .t-small { color: #f3e6cc; font-size: 15px; font-weight: 700; }
  .t-label { color: #f0a54e; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
  .t-accent { color: #f0a54e; font-size: 20px; font-weight: 700; }
  .t-note { color: #e2b77a; font-size: 17px; line-height: 1.25; }
  .t-ok { color: #8fd49b; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-bad { color: #ff8f73; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-row { background-color: #3a2716; border-radius: 12px; border-width: 2px; border-color: #86643c; }
  .t-slot { background-color: #3a2716; border-radius: 12px; border-width: 2px; border-color: #86643c; }
  .t-slottext { color: #f3e6cc; font-weight: 600; }
  .t-tile { flex-direction: column; align-items: center; justify-content: flex-end; background-color: #3a2716; border-radius: 12px; padding-bottom: 8px; padding-left: 6px; padding-right: 6px; }
  .t-tiletext { color: #f3e6cc; font-size: 15px; font-weight: 700; line-height: 1.2; text-align: center; }
  .t-detail { background-color: rgba(255, 220, 170, 0.08); border-radius: 12px; padding: 10px; color: #f3e6cc; font-size: 18px; line-height: 1.3; flex-shrink: 0; }
  .t-rule { height: 2px; background-color: rgba(196, 137, 63, 0.55); flex-shrink: 0; }
  .t-btn { background-color: #5e6e34; border-radius: 12px; }
  .t-go { background-color: #f0a54e; border-radius: 12px; }
  .t-track { background-color: rgba(255, 225, 180, 0.16); border-radius: 4px; }
  .t-fill { background-color: #f0a54e; border-radius: 4px; }
.theme-end { display: flex; }
  .root { flex-direction: column; width: 600px; padding-top: 18px; padding-bottom: 18px; padding-left: 20px; padding-right: 20px; gap: 8px; }
  .head { flex-direction: row; align-items: center; justify-content: space-between; height: 56px; flex-shrink: 0; }
  .titlebox { flex-direction: column; width: 360px; }
  .back { width: 170px; height: 56px; }
  .note { width: 560px; line-height: 1.25; }
  .grid { flex-direction: row; flex-wrap: wrap; gap: 8px; width: 560px; }
  .cell { width: 132px; height: 56px; justify-content: center; }
  .celltext { color: #f6ecd2; font-size: 16px; font-weight: 700; }
  .wide { width: 560px; height: 56px; justify-content: center; }
</style>
<div class="root t-root">
  <div class="head">
    <div class="titlebox">
      <div id="hint-eyebrow" class="t-label">HINT: FIND</div>
      <div id="hint-title" class="t-title">What are you looking for?</div>
    </div>
    <Button id="hint-close" class="back t-btn" size="lg" variant="secondary"><ButtonIcon><ArrowLeft></ArrowLeft></ButtonIcon><ButtonLabel>Back</ButtonLabel></Button>
  </div>
  <div id="find-note" class="note t-muted">Pick one: every one on the map gets a beacon you can see from far away.</div>
  <div class="grid">
    <Button id="find-0" class="t-btn cell" size="sm"><ButtonLabel id="find-0-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-1" class="t-btn cell" size="sm"><ButtonLabel id="find-1-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-2" class="t-btn cell" size="sm"><ButtonLabel id="find-2-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-3" class="t-btn cell" size="sm"><ButtonLabel id="find-3-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-4" class="t-btn cell" size="sm"><ButtonLabel id="find-4-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-5" class="t-btn cell" size="sm"><ButtonLabel id="find-5-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-6" class="t-btn cell" size="sm"><ButtonLabel id="find-6-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-7" class="t-btn cell" size="sm"><ButtonLabel id="find-7-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-8" class="t-btn cell" size="sm"><ButtonLabel id="find-8-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-9" class="t-btn cell" size="sm"><ButtonLabel id="find-9-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-10" class="t-btn cell" size="sm"><ButtonLabel id="find-10-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-11" class="t-btn cell" size="sm"><ButtonLabel id="find-11-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-12" class="t-btn cell" size="sm"><ButtonLabel id="find-12-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-13" class="t-btn cell" size="sm"><ButtonLabel id="find-13-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-14" class="t-btn cell" size="sm"><ButtonLabel id="find-14-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-15" class="t-btn cell" size="sm"><ButtonLabel id="find-15-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-16" class="t-btn cell" size="sm"><ButtonLabel id="find-16-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-17" class="t-btn cell" size="sm"><ButtonLabel id="find-17-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-18" class="t-btn cell" size="sm"><ButtonLabel id="find-18-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-19" class="t-btn cell" size="sm"><ButtonLabel id="find-19-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-20" class="t-btn cell" size="sm"><ButtonLabel id="find-20-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-21" class="t-btn cell" size="sm"><ButtonLabel id="find-21-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-22" class="t-btn cell" size="sm"><ButtonLabel id="find-22-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-23" class="t-btn cell" size="sm"><ButtonLabel id="find-23-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-24" class="t-btn cell" size="sm"><ButtonLabel id="find-24-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-25" class="t-btn cell" size="sm"><ButtonLabel id="find-25-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-26" class="t-btn cell" size="sm"><ButtonLabel id="find-26-label" class="celltext">-</ButtonLabel></Button>
    <Button id="find-27" class="t-btn cell" size="sm"><ButtonLabel id="find-27-label" class="celltext">-</ButtonLabel></Button>
  </div>
  <Button id="find-clear" class="wide t-btn" size="lg"><ButtonLabel id="find-clear-label" class="celltext">Clear beacons</ButtonLabel></Button>
</div>

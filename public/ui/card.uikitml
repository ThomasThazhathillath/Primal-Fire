<!-- A new Lab Notebook entry: Observation -> Principle -> Real-world limit. -->
<style>
  .theme-begin { display: flex; }
  .t-root { background-color: rgba(240, 226, 192, 0.98); border-radius: 18px; border-width: 6px; border-color: #5a3a1c; }
  .t-head { background-color: #4f5f33; border-radius: 12px; padding: 8px; }
  .t-headtext { color: #f6ecd2; font-size: 20px; font-weight: 700; }
  .t-title { color: #2d1f12; font-size: 24px; font-weight: 700; line-height: 1.15; }
  .t-name { color: #2d1f12; font-size: 20px; font-weight: 700; }
  .t-lead { color: #2d1f12; font-size: 20px; line-height: 1.25; }
  .t-body { color: #2d1f12; font-size: 19px; line-height: 1.3; }
  .t-muted { color: #5a4630; font-size: 18px; line-height: 1.3; }
  .t-small { color: #2d1f12; font-size: 15px; font-weight: 700; }
  .t-label { color: #9c4314; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
  .t-accent { color: #9c4314; font-size: 20px; font-weight: 700; }
  .t-note { color: #7a3e14; font-size: 17px; line-height: 1.25; }
  .t-ok { color: #2c7a3e; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-bad { color: #a8301c; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-row { background-color: rgba(255, 250, 236, 0.72); border-radius: 12px; border-width: 2px; border-color: rgba(90, 58, 28, 0.38); }
  .t-slot { background-color: rgba(255, 250, 236, 0.72); border-radius: 12px; border-width: 2px; border-color: rgba(90, 58, 28, 0.38); }
  .t-slottext { color: #2d1f12; font-weight: 600; }
  .t-rule { height: 2px; background-color: rgba(90, 58, 28, 0.35); flex-shrink: 0; }
  .t-btn { background-color: #4f5f33; border-radius: 12px; }
  .t-go { background-color: #9c4314; border-radius: 12px; }
  .t-track { background-color: rgba(90, 60, 28, 0.22); border-radius: 4px; }
  .t-fill { background-color: #9c4314; border-radius: 4px; }
.theme-end { display: flex; }
  .root { flex-direction: column; width: 440px; padding-top: 22px; padding-bottom: 22px; padding-left: 26px; padding-right: 26px; gap: 10px; }
  .body { line-height: 1.35; }
  .btnrow { flex-direction: row; gap: 14px; }
  .back { width: 190px; height: 60px; }
</style>
<div class="root t-root">
  <div id="card-eyebrow" class="eyebrow t-label">NEW OBSERVATION</div>
  <div id="card-title" class="title t-title">-</div>
  <div class="t-rule"></div>
  <div class="label t-label">OBSERVATION</div>
  <div id="card-obs" class="body t-body">-</div>
  <div class="label t-label">PRINCIPLE</div>
  <div id="card-pri" class="body t-body">-</div>
  <div id="card-lim-label" class="label t-label">REAL-WORLD LIMIT</div>
  <div id="card-lim" class="body t-body">-</div>
  <div id="card-why-label" class="label t-label">WHY DID THAT WORK?</div>
  <div id="card-why" class="body t-body">-</div>
  <div class="btnrow">
    <Button id="card-back" class="back t-btn" variant="secondary" size="lg"><ButtonIcon><ArrowLeft></ArrowLeft></ButtonIcon><ButtonLabel>Back</ButtonLabel></Button>
    <Button id="card-ok" class="t-go" size="lg"><ButtonIcon><Check></Check></ButtonIcon><ButtonLabel>Next</ButtonLabel></Button>
  </div>
</div>

<!--
  Quest + XP HUD. In the browser it is pinned top-left (ScreenSpace); in VR it
  follows lazily, low and to the left, inside a comfortable field of view.
  Step lines step-0..step-5 and the toast line are filled in by HudSystem.
-->
<style>
  .root { flex-direction: column; width: 400px; padding-top: 20px; padding-bottom: 20px; padding-left: 24px; padding-right: 24px; gap: 8px; }
  .row { flex-direction: row; justify-content: space-between; align-items: center; }
  .eyebrow { color: #8a5a00; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
  .eyebrow:dark { color: #ffb547; }
  .title { color: #1c1d20; font-size: 26px; font-weight: 700; }
  .title:dark { color: #f3eadb; }
  .desc { color: #55504a; font-size: 18px; line-height: 1.3; }
  .desc:dark { color: #b9ab95; }
  .step { color: #2a2620; font-size: 19px; line-height: 1.3; }
  .step:dark { color: #f3eadb; }
  .level { color: #2a2620; font-size: 16px; font-weight: 700; }
  .level:dark { color: #f3eadb; }
  .bar { height: 6px; width: 350px; background-color: #3a3128; border-radius: 3px; }
  .fill { height: 6px; width: 0px; background-color: #ffb547; border-radius: 3px; }
  .toast { color: #1c1d20; font-size: 20px; font-weight: 700; padding-top: 6px; }
  .toast:dark { color: #ffd27a; }
  .hover { color: #2a2620; font-size: 18px; line-height: 1.3; }
  .hover:dark { color: #cfe8cf; }
  .buttons { flex-direction: row; gap: 18px; padding-top: 10px; }
  .body { flex-direction: column; gap: 6px; display: none; }
</style>
<Panel class="root">
  <div class="row">
    <div id="quest-num" class="eyebrow">QUEST 1 / 6</div>
    <div class="row">
      <div id="level" class="level">Level 1  0 XP</div>
      <Button id="close-x-button" size="sm" variant="secondary"><ButtonIcon><X></X></ButtonIcon></Button>
    </div>
  </div>
  <div class="bar"><div id="xp-fill" class="fill"></div></div>
  <div id="quest-title" class="title">Scavenger</div>
  <!-- The quest's details stay folded away until you open them (the list icon). -->
  <div id="quest-body" class="body">
    <div id="quest-desc" class="desc">...</div>
    <div id="step-0" class="step">-</div>
    <div id="step-1" class="step">-</div>
    <div id="step-2" class="step">-</div>
    <div id="step-3" class="step">-</div>
    <div id="step-4" class="step">-</div>
    <div id="step-5" class="step">-</div>
  </div>
  <div id="toast" class="toast"> </div>
  <!-- What you point at and what you can do with it (no floating tooltip in the world). -->
  <div id="hover" class="hover"> </div>
  <!-- Small icon buttons: each opens or closes one thing. -->
  <!-- Shown only in the flat view, when the headset can enter VR. -->
  <Button id="enter-vr-button" size="sm"><ButtonIcon><Glasses></Glasses></ButtonIcon><ButtonLabel>Enter VR</ButtonLabel></Button>
  <div class="buttons">
    <Button id="quest-button" size="sm"><ButtonIcon><ListChecks></ListChecks></ButtonIcon></Button>
    <Button id="satchel-button" size="sm"><ButtonIcon><Backpack></Backpack></ButtonIcon></Button>
    <Button id="hint-button" size="sm"><ButtonIcon><Lightbulb></Lightbulb></ButtonIcon></Button>
    <Button id="guide-button" size="sm"><ButtonIcon><Compass></Compass></ButtonIcon></Button>
    <Button id="notebook-button" size="sm">
      <ButtonIcon><BookOpen></BookOpen></ButtonIcon>
      <ButtonLabel id="notebook-label"> </ButtonLabel>
    </Button>
  </div>
  <div class="buttons">
    <Button id="stow-button" size="sm"><ButtonIcon><Hand></Hand></ButtonIcon><ButtonLabel id="stow-label">Put away</ButtonLabel></Button>
    <Button id="drop-button" size="sm"><ButtonIcon><ArrowDownToLine></ArrowDownToLine></ButtonIcon><ButtonLabel>Drop</ButtonLabel></Button>
  </div>
  <div class="buttons">
    <Button id="turn-left-button" size="sm"><ButtonIcon><RotateCcw></RotateCcw></ButtonIcon></Button>
    <Button id="turn-right-button" size="sm"><ButtonIcon><RotateCw></RotateCw></ButtonIcon></Button>
    <Button id="remove-build-button" size="sm"><ButtonIcon><Trash2></Trash2></ButtonIcon></Button>
    <Button id="reload-button" size="sm"><ButtonIcon><RefreshCw></RefreshCw></ButtonIcon></Button>
    <Button id="exit-vr-button" size="sm"><ButtonIcon><LogOut></LogOut></ButtonIcon></Button>
  </div>
</Panel>

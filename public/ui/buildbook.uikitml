<!--
  The build book: one row per buildable. Tap a row to place its outline in front of you.
  Rows entry-0..entry-7 are filled in by BuildBookSystem, one page at a time (Prev/Next).
-->
<style>
  .theme-begin { display: flex; }
  .t-root { background-color: rgba(24, 16, 10, 0.98); border-radius: 18px; border-width: 8px; border-color: #6b4524; }
  .t-banner { flex-direction: row; align-items: center; justify-content: space-between; background-color: #5a2f16; border-radius: 12px; border-bottom-width: 4px; border-color: #c4893f; padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 10px; flex-shrink: 0; }
  .t-bannertext { color: #fbf0d6; font-size: 24px; font-weight: 700; letter-spacing: 1px; }
  .t-head { background-color: #5e6e34; border-radius: 12px; padding: 8px; }
  .t-headtext { color: #fbf0d6; font-size: 20px; font-weight: 700; }
  .t-title { color: #f3e6cc; font-size: 24px; font-weight: 700; line-height: 1.15; }
  .t-name { color: #f3e6cc; font-size: 20px; font-weight: 700; }
  .t-lead { color: #f3e6cc; font-size: 20px; line-height: 1.25; }
  .t-body { color: #f3e6cc; font-size: 19px; line-height: 1.3; }
  .t-muted { color: #cdb894; font-size: 18px; line-height: 1.3; }
  .t-small { color: #f3e6cc; font-size: 15px; font-weight: 700; }
  .t-label { color: #f0a54e; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
  .t-accent { color: #f0a54e; font-size: 20px; font-weight: 700; }
  .t-note { color: #e2b77a; font-size: 17px; line-height: 1.25; }
  .t-ok { color: #8fd49b; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-bad { color: #ff8f73; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-row { background-color: #3a2716; border-radius: 12px; border-width: 2px; border-color: #86643c; }
  .t-slot { background-color: #3a2716; border-radius: 12px; border-width: 2px; border-color: #86643c; }
  .t-slottext { color: #f3e6cc; font-weight: 600; }
  .t-tile { flex-direction: column; align-items: center; justify-content: flex-end; background-color: #3a2716; border-radius: 12px; padding-bottom: 8px; padding-left: 6px; padding-right: 6px; }
  .t-tiletext { color: #f3e6cc; font-size: 15px; font-weight: 700; line-height: 1.2; text-align: center; }
  .t-detail { background-color: rgba(255, 220, 170, 0.08); border-radius: 12px; padding: 10px; color: #f3e6cc; font-size: 18px; line-height: 1.3; flex-shrink: 0; }
  .t-rule { height: 2px; background-color: rgba(196, 137, 63, 0.55); flex-shrink: 0; }
  .t-btn { background-color: #5e6e34; border-radius: 12px; }
  .t-go { background-color: #f0a54e; border-radius: 12px; }
  .t-track { background-color: rgba(255, 225, 180, 0.16); border-radius: 4px; }
  .t-fill { background-color: #f0a54e; border-radius: 4px; }
.theme-end { display: flex; }
  .root { flex-direction: column; width: 520px; padding-top: 20px; padding-bottom: 20px; padding-left: 24px; padding-right: 24px; gap: 10px; }
  .sub { line-height: 1.3; }
  .list { flex-direction: row; flex-wrap: wrap; gap: 10px; flex-shrink: 0; width: 472px; }
  .entry { width: 110px; height: 120px; flex-shrink: 0; }
  .bagtext { font-size: 20px; line-height: 1.2; }
  .pager { flex-direction: row; gap: 10px; align-items: center; flex-shrink: 0; }
  .row { flex-direction: row; gap: 10px; flex-shrink: 0; }
  .back { width: 190px; height: 60px; }
</style>
<div class="root t-root">
  <div class="t-banner"><div class="t-bannertext">Build book</div></div>
  <div id="book-sub" class="sub t-muted">Tap a build to place its outline in front of you, then fill every mark.</div>
  <div class="list">
    <Button id="entry-0" class="entry t-tile" variant="secondary" size="sm"><ButtonLabel id="entry-0-label" class="bagtext t-tiletext">-</ButtonLabel></Button>
    <Button id="entry-1" class="entry t-tile" variant="secondary" size="sm"><ButtonLabel id="entry-1-label" class="bagtext t-tiletext">-</ButtonLabel></Button>
    <Button id="entry-2" class="entry t-tile" variant="secondary" size="sm"><ButtonLabel id="entry-2-label" class="bagtext t-tiletext">-</ButtonLabel></Button>
    <Button id="entry-3" class="entry t-tile" variant="secondary" size="sm"><ButtonLabel id="entry-3-label" class="bagtext t-tiletext">-</ButtonLabel></Button>
    <Button id="entry-4" class="entry t-tile" variant="secondary" size="sm"><ButtonLabel id="entry-4-label" class="bagtext t-tiletext">-</ButtonLabel></Button>
    <Button id="entry-5" class="entry t-tile" variant="secondary" size="sm"><ButtonLabel id="entry-5-label" class="bagtext t-tiletext">-</ButtonLabel></Button>
    <Button id="entry-6" class="entry t-tile" variant="secondary" size="sm"><ButtonLabel id="entry-6-label" class="bagtext t-tiletext">-</ButtonLabel></Button>
    <Button id="entry-7" class="entry t-tile" variant="secondary" size="sm"><ButtonLabel id="entry-7-label" class="bagtext t-tiletext">-</ButtonLabel></Button>
  </div>
  <div id="book-detail" class="t-detail">-</div>
  <div class="pager">
    <Button id="book-prev" class="t-btn" variant="secondary" size="sm"><ButtonLabel>Prev</ButtonLabel></Button>
    <div id="book-page" class="page t-muted">1 / 1</div>
    <Button id="book-next" class="t-btn" variant="secondary" size="sm"><ButtonLabel>Next</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="book-close" class="back t-btn" variant="secondary" size="lg"><ButtonIcon><ArrowLeft></ArrowLeft></ButtonIcon><ButtonLabel>Back</ButtonLabel></Button>
  </div>
</div>

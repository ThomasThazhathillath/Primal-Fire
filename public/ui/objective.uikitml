<!--
  The objective card: ONE current objective, compact, near the top of view.
  Hierarchy: a big title, one short action line, a progress bar, and a small
  "How?" that expands the longer how-to. The celebrate row (check mark) replaces
  the body for a moment when an objective is finished. Texts are filled in by
  ObjectiveCardSystem; colours and type come from the shared theme block.
-->
<style>
  .theme-begin { display: flex; }
  .t-root { background-color: rgba(24, 16, 10, 0.98); border-radius: 18px; border-width: 8px; border-color: #6b4524; }
  .t-banner { flex-direction: row; align-items: center; justify-content: space-between; background-color: #5a2f16; border-radius: 12px; border-bottom-width: 4px; border-color: #c4893f; padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 10px; flex-shrink: 0; }
  .t-bannertext { color: #fbf0d6; font-size: 24px; font-weight: 700; letter-spacing: 1px; }
  .t-head { background-color: #5e6e34; border-radius: 12px; padding: 8px; }
  .t-headtext { color: #fbf0d6; font-size: 20px; font-weight: 700; }
  .t-title { color: #f3e6cc; font-size: 24px; font-weight: 700; line-height: 1.15; }
  .t-name { color: #f3e6cc; font-size: 20px; font-weight: 700; }
  .t-lead { color: #f3e6cc; font-size: 20px; line-height: 1.25; }
  .t-body { color: #f3e6cc; font-size: 19px; line-height: 1.3; }
  .t-muted { color: #cdb894; font-size: 18px; line-height: 1.3; }
  .t-small { color: #f3e6cc; font-size: 15px; font-weight: 700; }
  .t-label { color: #f0a54e; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
  .t-accent { color: #f0a54e; font-size: 20px; font-weight: 700; }
  .t-note { color: #e2b77a; font-size: 17px; line-height: 1.25; }
  .t-ok { color: #8fd49b; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-bad { color: #ff8f73; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-row { background-color: #3a2716; border-radius: 12px; border-width: 2px; border-color: #86643c; }
  .t-slot { background-color: #3a2716; border-radius: 12px; border-width: 2px; border-color: #86643c; }
  .t-slottext { color: #f3e6cc; font-weight: 600; }
  .t-tile { flex-direction: column; align-items: center; justify-content: flex-end; background-color: #3a2716; border-radius: 12px; padding-bottom: 8px; padding-left: 6px; padding-right: 6px; }
  .t-tiletext { color: #f3e6cc; font-size: 15px; font-weight: 700; line-height: 1.2; text-align: center; }
  .t-detail { background-color: rgba(255, 220, 170, 0.08); border-radius: 12px; padding: 10px; color: #f3e6cc; font-size: 18px; line-height: 1.3; flex-shrink: 0; }
  .t-rule { height: 2px; background-color: rgba(196, 137, 63, 0.55); flex-shrink: 0; }
  .t-btn { background-color: #5e6e34; border-radius: 12px; }
  .t-go { background-color: #f0a54e; border-radius: 12px; }
  .t-track { background-color: rgba(255, 225, 180, 0.16); border-radius: 4px; }
  .t-fill { background-color: #f0a54e; border-radius: 4px; }
.theme-end { display: flex; }
  .root { flex-direction: column; width: 520px; height: 330px; padding-top: 16px; padding-bottom: 14px; padding-left: 20px; padding-right: 16px; gap: 6px; justify-content: flex-start; }
  .head { flex-direction: row; align-items: center; justify-content: space-between; min-height: 56px; flex-shrink: 0; }
  .titlebox { flex-direction: column; width: 360px; }
  .btns { flex-direction: row; gap: 8px; }
  .body { flex-direction: column; gap: 8px; flex-shrink: 0; }
  .instr { width: 480px; }
  .where { width: 480px; height: 0px; overflow: hidden; flex-shrink: 0; }
  .prow { flex-direction: row; align-items: center; gap: 12px; flex-shrink: 0; }
  .bar { height: 10px; width: 330px; }
  .fill { height: 10px; width: 0px; }
  .howrow { flex-direction: row; align-items: center; gap: 12px; flex-shrink: 0; height: 0px; overflow: hidden; }
  .how { height: 40px; }
  .subs { height: 0px; overflow: hidden; flex-shrink: 0; width: 480px; }
  .parts { height: 0px; overflow: hidden; flex-shrink: 0; width: 480px; }
  .next { height: 0px; overflow: hidden; flex-shrink: 0; width: 480px; }
  .note { height: 0px; overflow: hidden; flex-shrink: 0; width: 480px; }
  .bad { height: 0px; overflow: hidden; flex-shrink: 0; width: 480px; }
  .cele { flex-direction: row; align-items: center; gap: 14px; background-color: #2c6a3d; border-radius: 12px; padding: 12px; display: none; flex-shrink: 0; }
  .celetext { color: #ffffff; font-size: 22px; font-weight: 700; line-height: 1.25; width: 400px; }
</style>
<div id="obj-root" class="root t-root">
  <div class="head t-banner">
    <div class="titlebox">
      <div id="obj-step" class="t-label">OBJECTIVE</div>
      <div id="obj-title" class="t-title">Find your first stone</div>
    </div>
    <div class="btns">
      <Button id="obj-hint" class="t-btn" size="sm" variant="secondary"><ButtonIcon><Lightbulb></Lightbulb></ButtonIcon></Button>
      <Button id="obj-close" class="t-btn" size="sm" variant="secondary"><ButtonIcon><X></X></ButtonIcon></Button>
    </div>
  </div>
  <div id="obj-body" class="body">
    <div id="obj-instr" class="instr t-lead">-</div>
    <div id="obj-where" class="where t-ok"> </div>
    <div id="obj-prow" class="prow">
      <div id="obj-ptext" class="t-accent">0 / 1</div>
      <div class="bar t-track"><div id="obj-fill" class="fill t-fill"></div></div>
    </div>
    <div id="obj-parts" class="parts t-muted">-</div>
    <div id="obj-subs" class="subs t-muted">-</div>
    <div id="obj-next" class="next t-accent">-</div>
    <div id="obj-howrow" class="howrow">
      <Button id="obj-how" class="how t-btn" size="sm" variant="secondary"><ButtonLabel id="obj-how-label">How?</ButtonLabel></Button>
    </div>
    <div id="obj-note" class="note t-note">-</div>
    <div id="obj-bad" class="bad t-bad">-</div>
  </div>
  <div id="obj-cele" class="cele">
    <Button id="obj-check" size="sm" variant="secondary"><ButtonIcon><Check></Check></ButtonIcon></Button>
    <div id="obj-cele-text" class="celetext">-</div>
  </div>
</div>

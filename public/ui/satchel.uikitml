<!--
  The satchel: tap an item with a fingertip to take it in hand. Item buttons item-0..item-17
  are filled in by SatchelSystem; craft buttons appear at a workbench.
-->
<style>
  .root { flex-direction: column; width: 460px; padding-top: 20px; padding-bottom: 20px; padding-left: 24px; padding-right: 24px; gap: 10px; }
  .title { color: #1c1d20; font-size: 24px; font-weight: 700; }
  .title:dark { color: #f3eadb; }
  .sub { color: #55504a; font-size: 18px; }
  .sub:dark { color: #b9ab95; }
  .grid { flex-direction: row; flex-wrap: wrap; gap: 8px; }
  .item { width: 134px; }
  .bagrow { width: 412px; }
  .bagtext { font-size: 15px; }
  .row { flex-direction: row; gap: 10px; }
  .back { width: 190px; height: 60px; }
</style>
<Panel class="root">
  <div class="title">Bag</div>
  <div id="satchel-sub" class="sub">Tap an item to take it in hand. Tap Back to return to the icons.</div>
  <div class="grid">
    <Button id="item-0" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-0-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-1" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-1-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-2" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-2-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-3" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-3-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-4" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-4-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-5" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-5-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-6" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-6-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-7" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-7-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-8" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-8-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-9" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-9-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-10" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-10-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-11" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-11-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-12" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-12-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-13" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-13-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-14" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-14-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-15" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-15-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-16" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-16-label" class="bagtext">-</ButtonLabel></Button>
    <Button id="item-17" class="bagrow" variant="secondary" size="sm"><ButtonLabel id="item-17-label" class="bagtext">-</ButtonLabel></Button>
  </div>
  <div id="make-title" class="sub">Make by hand (you have the parts):</div>
  <div class="grid">
    <Button id="make-0" class="item" size="sm"><ButtonLabel id="make-0-label">-</ButtonLabel></Button>
    <Button id="make-1" class="item" size="sm"><ButtonLabel id="make-1-label">-</ButtonLabel></Button>
    <Button id="make-2" class="item" size="sm"><ButtonLabel id="make-2-label">-</ButtonLabel></Button>
    <Button id="make-3" class="item" size="sm"><ButtonLabel id="make-3-label">-</ButtonLabel></Button>
    <Button id="make-4" class="item" size="sm"><ButtonLabel id="make-4-label">-</ButtonLabel></Button>
    <Button id="make-5" class="item" size="sm"><ButtonLabel id="make-5-label">-</ButtonLabel></Button>
    <Button id="make-6" class="item" size="sm"><ButtonLabel id="make-6-label">-</ButtonLabel></Button>
    <Button id="make-7" class="item" size="sm"><ButtonLabel id="make-7-label">-</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="stow-button" variant="secondary" size="sm"><ButtonIcon><Undo2></Undo2></ButtonIcon><ButtonLabel id="stow-label">Put back</ButtonLabel></Button>
    <Button id="satchel-close" class="back" variant="secondary" size="lg"><ButtonIcon><ArrowLeft></ArrowLeft></ButtonIcon><ButtonLabel>Back</ButtonLabel></Button>
  </div>
</Panel>

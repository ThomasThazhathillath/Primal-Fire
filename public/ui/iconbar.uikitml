<!--
  Icon bar / grid: one fixed-size slot per action (icon + a short text label), so every
  slot is a big, readable fingertip target. Slots are shown or hidden by state; the
  grid folds to the Menu button while a panel is open. The small dot marks an open
  card; the notebook slot's badge counts new entries. PanelTouch reads each slot's
  real layout, so nothing here needs to be measured by hand.
-->
<style>
  .theme-begin { display: flex; }
  .t-root { background-color: rgba(62, 40, 22, 0.96); border-radius: 18px; }
  .t-title { color: #f8eedb; font-size: 30px; font-weight: 700; }
  .t-name { color: #f8eedb; font-size: 25px; font-weight: 700; }
  .t-lead { color: #f8eedb; font-size: 22px; line-height: 1.25; }
  .t-body { color: #f8eedb; font-size: 21px; line-height: 1.3; }
  .t-muted { color: #d3c4a6; font-size: 18px; line-height: 1.3; }
  .t-small { color: #f8eedb; font-size: 15px; font-weight: 700; }
  .t-label { color: #ff8a3d; font-size: 14px; font-weight: 700; letter-spacing: 1.5px; }
  .t-accent { color: #ff8a3d; font-size: 22px; font-weight: 700; }
  .t-note { color: #ffc283; font-size: 17px; line-height: 1.25; }
  .t-ok { color: #86dc97; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-bad { color: #ff9684; font-size: 18px; font-weight: 700; line-height: 1.25; }
  .t-row { background-color: rgba(255, 200, 140, 0.13); border-radius: 12px; }
  .t-btn { background-color: rgba(255, 200, 140, 0.13); border-radius: 12px; }
  .t-go { background-color: #ff8a3d; border-radius: 12px; }
  .t-track { background-color: rgba(255, 200, 140, 0.20); border-radius: 4px; }
  .t-fill { background-color: #ff8a3d; border-radius: 4px; }
.theme-end { display: flex; }
  .bar { flex-direction: row; align-items: center; justify-content: flex-start; height: 90px; padding-left: 8px; padding-right: 8px; gap: 10px; }
  .slot { width: 68px; height: 80px; flex-direction: column; align-items: center; justify-content: center; gap: 1px; border-radius: 12px; }
  .dot { width: 7px; height: 7px; border-radius: 4px; background-color: #ff8a3d; display: none; }
  .badge { padding-left: 5px; padding-right: 5px; height: 14px; border-radius: 7px; background-color: #ff7a45; color: #ffffff; font-size: 11px; font-weight: 700; align-items: center; justify-content: center; display: none; }
</style>
<Panel id="bar" class="bar t-root">
  <div id="slot-0" class="slot"><Button class="t-btn" id="ic-satchel" size="sm" variant="secondary"><ButtonIcon><Backpack></Backpack></ButtonIcon></Button><div id="lbl-0" class="lbl t-small">Bag</div><div id="dot-0" class="dot"></div></div>
  <div id="slot-1" class="slot"><Button class="t-btn" id="ic-quest" size="sm" variant="secondary"><ButtonIcon><ListChecks></ListChecks></ButtonIcon></Button><div id="lbl-1" class="lbl t-small">Quest</div><div id="dot-1" class="dot"></div></div>
  <div id="slot-2" class="slot"><Button class="t-btn" id="ic-hint" size="sm" variant="secondary"><ButtonIcon><Lightbulb></Lightbulb></ButtonIcon></Button><div id="lbl-2" class="lbl t-small">Hint</div><div id="dot-2" class="dot"></div></div>
  <div id="slot-3" class="slot"><Button class="t-btn" id="ic-guide" size="sm" variant="secondary"><ButtonIcon><Compass></Compass></ButtonIcon></Button><div id="lbl-3" class="lbl t-small">Guide</div><div id="dot-3" class="dot"></div></div>
  <div id="slot-4" class="slot"><Button class="t-btn" id="ic-notebook" size="sm" variant="secondary"><ButtonIcon><BookOpen></BookOpen></ButtonIcon></Button><div id="lbl-4" class="lbl t-small">Notes</div><div id="badge-4" class="badge">0</div></div>
  <div id="slot-5" class="slot"><Button class="t-btn" id="ic-stow" size="sm" variant="secondary"><ButtonIcon><Hand></Hand></ButtonIcon></Button><div id="lbl-5" class="lbl t-small">Put away</div></div>
  <div id="slot-6" class="slot"><Button class="t-btn" id="ic-drop" size="sm" variant="secondary"><ButtonIcon><ArrowDownToLine></ArrowDownToLine></ButtonIcon></Button><div id="lbl-6" class="lbl t-small">Drop</div></div>
  <div id="slot-7" class="slot"><Button class="t-btn" id="ic-turn-left" size="sm" variant="secondary"><ButtonIcon><RotateCcw></RotateCcw></ButtonIcon></Button><div id="lbl-7" class="lbl t-small">Turn L</div></div>
  <div id="slot-8" class="slot"><Button class="t-btn" id="ic-turn-right" size="sm" variant="secondary"><ButtonIcon><RotateCw></RotateCw></ButtonIcon></Button><div id="lbl-8" class="lbl t-small">Turn R</div></div>
  <div id="slot-9" class="slot"><Button class="t-btn" id="ic-remove" size="sm" variant="secondary"><ButtonIcon><Trash2></Trash2></ButtonIcon></Button><div id="lbl-9" class="lbl t-small">Remove</div></div>
  <div id="slot-10" class="slot"><Button class="t-btn" id="ic-reload" size="sm" variant="secondary"><ButtonIcon><RefreshCw></RefreshCw></ButtonIcon></Button><div id="lbl-10" class="lbl t-small">Reload</div></div>
  <div id="slot-11" class="slot"><Button class="t-btn" id="ic-exit" size="sm" variant="secondary"><ButtonIcon><LogOut></LogOut></ButtonIcon></Button><div id="lbl-11" class="lbl t-small">Exit</div></div>
  <div id="slot-12" class="slot"><Button class="t-btn" id="ic-book" size="sm" variant="secondary"><ButtonIcon><Hammer></Hammer></ButtonIcon></Button><div id="lbl-12" class="lbl t-small">Build</div></div>
  <div id="slot-13" class="slot"><Button class="t-btn" id="ic-restart" size="sm" variant="secondary"><ButtonIcon><ListRestart></ListRestart></ButtonIcon></Button><div id="lbl-13" class="lbl t-small">Restart</div></div>
  <div id="slot-14" class="slot"><Button class="t-btn" id="ic-menu" size="sm" variant="secondary"><ButtonIcon><LayoutGrid></LayoutGrid></ButtonIcon></Button><div id="lbl-14" class="lbl t-small">Menu</div></div>
  <div id="slot-15" class="slot"><Button class="t-btn" id="ic-bench" size="sm" variant="secondary"><ButtonIcon><Wrench></Wrench></ButtonIcon></Button><div id="lbl-15" class="lbl t-small">Bench</div></div>
  <div id="slot-16" class="slot"><Button class="t-btn" id="ic-story" size="sm" variant="secondary"><ButtonIcon><Compass></Compass></ButtonIcon></Button><div id="lbl-16" class="lbl t-small">Story</div></div>
</Panel>
